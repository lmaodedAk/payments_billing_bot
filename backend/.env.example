# ════════════════════════════════════════════════════════════════════════════
# Zia Assistant backend — environment variables
# Template: copy to .env and fill in real values. NEVER commit .env.
#
# Legend:
#   [VERCEL: REQUIRED]  must exist in Vercel → Settings → Environment Variables
#                       (Production + Preview) or the server refuses to start.
#   [VERCEL: OPTIONAL]  recommended in Vercel; server starts without it.
#   [LOCAL ONLY]        do not add to Vercel.
#
# After changing anything in Vercel you must REDEPLOY — env changes do not
# apply to an already-running deployment.
# ════════════════════════════════════════════════════════════════════════════

# [LOCAL ONLY] Port for "npm run dev". Vercel ignores it.
PORT=4000

# ── Zoho OAuth (service account used ONLY to call the Zia Agent API) ────────
# [VERCEL: OPTIONAL] Defaults to https://accounts.zoho.com (US data centre).
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
# [VERCEL: REQUIRED]
ZOHO_CLIENT_ID=your_client_id_here
# [VERCEL: REQUIRED] Secret — mark as Sensitive in Vercel.
ZOHO_CLIENT_SECRET=your_client_secret_here
# [VERCEL: REQUIRED] Secret — mark as Sensitive in Vercel.
# This token belongs to an Administrator. Make sure the Zia Agent it calls has
# NO Zoho CRM tools/connections, or Standard users can reach Admin data via chat.
ZOHO_REFRESH_TOKEN=your_refresh_token_here

# ── Zia Agent ───────────────────────────────────────────────────────────────
# [VERCEL: REQUIRED] /query is the endpoint the live deployment is verified with.
# (Previous local value, kept for reference — untested in production:
#  https://ziaagents.zoho.com/ziaagents/api/v1/agents/<ZIA_AGENT_ID>/trigger)
ZIA_AGENT_URL=https://ziaagents.zoho.com/ziaagents/api/v1/agents/query
# [VERCEL: REQUIRED]
ZIA_ORG_ID=your_zia_org_id_here
# [VERCEL: REQUIRED]
ZIA_AGENT_ID=your_agent_id_here
# [VERCEL: REQUIRED] Update whenever you publish a new agent version.
ZIA_VERSION_ID=your_agent_version_id_here

# ── CORS ────────────────────────────────────────────────────────────────────
# [VERCEL: REQUIRED for the CRM widget] Comma-separated origins.
#   https://127.0.0.1:5000  → local ZET server loaded inside Zoho CRM Sandbox
#   http://localhost:5173/5174 → React dev frontend
# When the widget is hosted by Zoho, add its origin here too
# (find it in the browser DevTools → Network → request "Origin" header).
ALLOWED_ORIGINS=https://127.0.0.1:5000,http://localhost:5173,http://localhost:5174

# [VERCEL: OPTIONAL] Leave empty — key-based access is not used.
API_KEYS=

# ── Widget authentication ───────────────────────────────────────────────────
# [VERCEL: REQUIRED] HMAC secret. Must be IDENTICAL to the Zoho CRM variable
# (API name: Widget_HMAC_Secret) read by the Deluge function get_chat_auth_token.
# Generate with: openssl rand -hex 32. Use different secrets for sandbox and production.
ZOHO_WIDGET_SECRET=generate_with_openssl_rand_hex_32

# ── Replay protection: Vercel KV / Upstash Redis ────────────────────────────
# [VERCEL: OPTIONAL now, REQUIRED for production] Without these, a replayed
# token is only caught if it hits the same serverless instance.
# Vercel → Storage → create KV/Upstash → link to project (auto-adds them).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
