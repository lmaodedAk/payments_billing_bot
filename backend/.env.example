# Copy this to .env and fill in your real values.
# NEVER commit .env to Git.
#
# Variables marked [REQUIRED] must be set or the server will refuse to start.
# Variables marked [REQUIRED FOR PRODUCTION] cause a startup error outside of
# test environments. They must be set in Vercel project settings before deploying.

PORT=4000

# ── Zoho OAuth [REQUIRED] ────────────────────────────────────────────────────
# Used to call the Zia Agent API on behalf of the backend service account.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_CLIENT_ID=your_client_id_here
ZOHO_CLIENT_SECRET=your_client_secret_here
ZOHO_REFRESH_TOKEN=your_refresh_token_here

# ── Zia Agent [REQUIRED] ─────────────────────────────────────────────────────
# Find these in Agent Studio → Integrate tab.
ZIA_ORG_ID=your_org_id_here
ZIA_AGENT_ID=your_agent_id_here
ZIA_VERSION_ID=your_agent_version_id_here
ZIA_AGENT_URL=https://zia.zoho.com/api/v1/agents/YOUR_AGENT_ID/query

# ── CORS [optional] ──────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
ALLOWED_ORIGINS=http://localhost:5173

# ── API Keys [optional] ──────────────────────────────────────────────────────
# Leave empty to disable key-based access (browser CORS origins still work).
API_KEYS=

# ── Widget Authentication [REQUIRED FOR PRODUCTION] ──────────────────────────
# HMAC-SHA256 secret shared between this backend and the Deluge function.
# Must match the CRM Org Variable 'widget_hmac_secret' exactly.
# Generate with: openssl rand -hex 32
# Set in Vercel: Settings → Environment Variables → ZOHO_WIDGET_SECRET
ZOHO_WIDGET_SECRET=your_hmac_secret_here

# ── Replay Protection: Vercel KV / Upstash Redis [REQUIRED FOR PRODUCTION] ───
# Required for atomic nonce consumption across serverless instances.
# Without this, multi-instance deployments fall back to per-instance in-memory
# nonce storage — replay attacks ARE possible across separate Vercel instances.
# Provision via: Vercel Dashboard → Storage → KV, or use Upstash Redis.
# These four vars are auto-populated when you link a Vercel KV store.
KV_REST_API_URL=https://your-kv-url.upstash.io
KV_REST_API_TOKEN=your_kv_rest_api_token_here
# Upstash Redis alternative (either pair works — nonceStore.js checks both):
# UPSTASH_REDIS_REST_URL=https://your-kv-url.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here
