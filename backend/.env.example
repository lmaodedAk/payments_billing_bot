# Copy this to .env and fill in your real values.
# NEVER commit .env to Git.

PORT=4000

# Zoho OAuth
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_CLIENT_ID=your_client_id_here
ZOHO_CLIENT_SECRET=your_client_secret_here
ZOHO_REFRESH_TOKEN=your_refresh_token_here

# Zia Agent  — find these in Agent Studio → Integrate tab
ZIA_ORG_ID=your_org_id_here
ZIA_AGENT_ID=your_agent_id_here
ZIA_VERSION_ID=your_agent_version_id_here

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

# API Keys — comma-separated, for server-to-server callers
# Leave empty to disable key-based access (browser CORS origins still work)
API_KEYS=
